.cam-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #1b2330;
}
.cam-view {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 兜底（未授权相机） */
.cam-fallback {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #fff;
  padding: 0 80rpx;
  text-align: center;
  background: linear-gradient(180deg, #2a3550, #1b2330);
}
.fb-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-top: 8rpx;
}
.fb-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.7);
}
.fb-btn {
  margin-top: 16rpx;
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #2f6fe0;
  background: #fff;
}
.fb-btn-hover {
  transform: scale(0.94);
}

/* 顶部 */
.imm-top {
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  z-index: 12;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.imm-back {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.28);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}
.imm-back-hover {
  transform: scale(0.9);
}
.imm-langpill {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 800;
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.28);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

/* 扫描线 */
.cam-scan {
  position: absolute;
  left: 60rpx;
  right: 60rpx;
  height: 6rpx;
  top: 240rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, transparent, #fff, transparent);
  box-shadow: 0 0 36rpx rgba(120, 180, 255, 0.95);
  animation: scan 2.4s ease-in-out infinite;
  z-index: 10;
}
@keyframes scan {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(460rpx); }
}

/* 底部控制 */
.cam-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  z-index: 12;
}
.cam-tip {
  font-size: 26rpx;
  font-weight: 700;
  color: #ffffff;
  padding: 14rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.42);
}
.cam-controls {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 72rpx;
}
.cam-side {
  width: 92rpx;
}
.shutter {
  width: 152rpx;
  height: 152rpx;
  border-radius: 50%;
  background: #fff;
  border: 10rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.9) inset;
}
.shutter-hover {
  transform: scale(0.92);
}
.shutter.shooting {
  animation: shoot 0.4s ease;
}
@keyframes shoot {
  50% { transform: scale(0.82); opacity: 0.7; }
}
.cam-gallery {
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
}
.gallery-hover {
  transform: scale(0.9);
}

/* 识别结果 */
.cam-mask {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 19;
  background: rgba(10, 20, 40, 0.25);
}
.cam-result {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  padding: 40rpx 40rpx 60rpx;
  border-radius: 56rpx 56rpx 0 0;
  background: #eef3fc;
  box-shadow: 0 -32rpx 100rpx rgba(30, 60, 130, 0.25);
  transform: translateY(110%);
  transition: transform 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
  max-height: 78%;
  overflow-y: auto;
}
.cam-result.show {
  transform: translateY(0);
}
.grip {
  width: 84rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(120, 150, 200, 0.4);
  margin: 0 auto 28rpx;
}
.rh {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.rh-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink-strong);
}
.cls {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(120, 150, 200, 0.12);
}
