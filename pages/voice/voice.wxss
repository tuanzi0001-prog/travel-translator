.voice-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, #f6f9ff 0%, #ebf2fd 55%, #dfeafb 100%);
}

/* 顶部 */
.v-top {
  width: 100%;
  padding: 12rpx 36rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 3;
}
.imm-back {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-shadow: var(--shadow-sm);
}
.imm-back-hover {
  transform: scale(0.9);
}
.imm-spacer {
  width: 84rpx;
}
.v-langpill {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink-strong);
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: #fff;
  box-shadow: var(--shadow-sm);
}

.v-status {
  margin-top: 64rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 0.5rpx;
  z-index: 2;
}

.v-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 0 60rpx;
  z-index: 2;
}
.vt-source {
  margin-bottom: 36rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #9aa7c2;
  line-height: 1.5;
}
.vt-target {
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.4;
  letter-spacing: -0.6rpx;
  color: var(--blue-deep);
}

/* 底部 */
.v-bottom {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 26rpx;
  padding-bottom: 50rpx;
  position: relative;
  z-index: 2;
}
.v-glow {
  position: absolute;
  left: 50%;
  bottom: -60rpx;
  width: 780rpx;
  height: 360rpx;
  transform: translateX(-50%);
  background: radial-gradient(
    58% 78% at 50% 100%,
    rgba(120, 170, 255, 0.45),
    rgba(255, 255, 255, 0) 72%
  );
  z-index: 0;
}

/* 频谱波形 */
.waveform {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 92rpx;
  z-index: 2;
}
.waveform .bar {
  width: 6rpx;
  background: var(--blue);
  border-radius: 999rpx;
  transition: height 0.2s ease;
  opacity: 0.9;
}
.waveform .bar:nth-child(3n) {
  background: #a6c6ff;
}
.waveform .bar:nth-child(1) { height: 20rpx; }
.waveform .bar:nth-child(2) { height: 40rpx; }
.waveform .bar:nth-child(3) { height: 64rpx; }
.waveform .bar:nth-child(4) { height: 32rpx; }
.waveform .bar:nth-child(5) { height: 52rpx; }
.waveform .bar:nth-child(6) { height: 80rpx; }
.waveform .bar:nth-child(7) { height: 44rpx; }
.waveform .bar:nth-child(8) { height: 24rpx; }
.waveform .bar:nth-child(9) { height: 60rpx; }
.waveform .bar:nth-child(10) { height: 36rpx; }
.waveform .bar:nth-child(11) { height: 68rpx; }
.waveform .bar:nth-child(12) { height: 48rpx; }
.waveform .bar:nth-child(13) { height: 28rpx; }
.waveform .bar:nth-child(14) { height: 56rpx; }
.waveform .bar:nth-child(15) { height: 80rpx; }
.waveform .bar:nth-child(16) { height: 40rpx; }
.waveform .bar:nth-child(17) { height: 60rpx; }
.waveform .bar:nth-child(18) { height: 24rpx; }
.waveform .bar:nth-child(19) { height: 44rpx; }
.waveform .bar:nth-child(20) { height: 28rpx; }

.waveform.live .bar {
  animation: wave 0.9s ease-in-out infinite;
}
.waveform.live .bar:nth-child(1) { animation-delay: 0s; }
.waveform.live .bar:nth-child(2) { animation-delay: 0.1s; }
.waveform.live .bar:nth-child(3) { animation-delay: 0.2s; }
.waveform.live .bar:nth-child(4) { animation-delay: 0.3s; }
.waveform.live .bar:nth-child(5) { animation-delay: 0.15s; }
.waveform.live .bar:nth-child(6) { animation-delay: 0.25s; }
.waveform.live .bar:nth-child(7) { animation-delay: 0.05s; }
.waveform.live .bar:nth-child(8) { animation-delay: 0.35s; }
.waveform.live .bar:nth-child(9) { animation-delay: 0.18s; }
.waveform.live .bar:nth-child(10) { animation-delay: 0.28s; }
.waveform.live .bar:nth-child(11) { animation-delay: 0.08s; }
.waveform.live .bar:nth-child(12) { animation-delay: 0.22s; }
.waveform.live .bar:nth-child(13) { animation-delay: 0.12s; }
.waveform.live .bar:nth-child(14) { animation-delay: 0.3s; }
.waveform.live .bar:nth-child(15) { animation-delay: 0.2s; }
.waveform.live .bar:nth-child(16) { animation-delay: 0.1s; }
.waveform.live .bar:nth-child(17) { animation-delay: 0.25s; }
.waveform.live .bar:nth-child(18) { animation-delay: 0.05s; }
.waveform.live .bar:nth-child(19) { animation-delay: 0.3s; }
.waveform.live .bar:nth-child(20) { animation-delay: 0.15s; }
@keyframes wave {
  0%, 100% { height: 16rpx; }
  50% { height: 64rpx; }
}

/* 麦克风同心圆 */
.mic-stage {
  position: relative;
  width: 340rpx;
  height: 300rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.mic-stage::before,
.mic-stage::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(75, 141, 248, 0.25);
}
.mic-stage::before {
  width: 300rpx;
  height: 300rpx;
  background: rgba(75, 141, 248, 0.05);
}
.mic-stage::after {
  width: 240rpx;
  height: 240rpx;
  background: rgba(75, 141, 248, 0.08);
}
.mic-stage.listening::before {
  animation: ring 1.8s ease-out infinite;
}
.mic-stage.listening::after {
  animation: ring 1.8s ease-out infinite 0.5s;
}
@keyframes ring {
  0% { transform: scale(0.8); opacity: 0.8; }
  100% { transform: scale(1.3); opacity: 0; }
}

.record-button {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  box-shadow: 0 20rpx 50rpx rgba(63, 126, 240, 0.28),
    inset 0 3rpx 6rpx rgba(255, 255, 255, 0.9);
  position: relative;
  z-index: 2;
}
.record-hover {
  transform: scale(0.92);
}
.record-button.listening {
  background: var(--blue-grad);
  animation: pulseBlue 1.6s ease-out infinite;
}
@keyframes pulseBlue {
  0% {
    box-shadow: 0 0 0 0 rgba(75, 141, 248, 0.45), var(--shadow-blue);
  }
  70% {
    box-shadow: 0 0 0 36rpx rgba(75, 141, 248, 0), var(--shadow-blue);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(75, 141, 248, 0), var(--shadow-blue);
  }
}

.record-hint {
  color: var(--muted);
  font-size: 24rpx;
  font-weight: 600;
  z-index: 2;
}
